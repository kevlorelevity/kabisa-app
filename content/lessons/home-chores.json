  "title": "Saturday Chores: Kazi za Nyumbani",
  "category": "home",
  "difficulty": "beginner",
  "level": 2,
  "order": 201,
  "theme": "home",
  "culturalNote": "Saturday morning is \"kazi za nyumbani\" time in most Kenyan homes: sweeping, mopping (\"kupiga deki\" — from the English \"deck\"), washing clothes by hand in a basin, and hanging them in the sun. Kenyans use different verbs for different kinds of washing: kuosha for dishes, cars and hands, kufua only for clothes. You share a flat in Kilimani with your friend Otieno.",
  "startingPoint": "Saturday, 9 a.m. Otieno bangs on your door with a broom in his hand.",
  "grammarFocus": [
    "present-na",
    "infinitive-ku",
    "adjective-agreement",
    "possessives"
  ],
  "grammar": [
    "present-na",
    "infinitive-ku",
    "adjective-agreement",
    "possessives",
    "greetings",
    "noun-classes-mwa-nn",
    "ni-copula",
    "subject-prefixes",
    "locative-ni",
    "ko-location",
    "question-words",
    "sanifu-noun-classes"
  ],
