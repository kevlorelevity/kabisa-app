{
  "functions": {
    "api/tts.ts": {
      "includeFiles": "content/lessons/**"
    },
    "api/ai-edit.ts": {
      "includeFiles": "content/grammar/**",
      "maxDuration": 300
    },
    "api/ai-followup.ts": {
      "maxDuration": 300
    },
    "api/style-guide.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
