# Copy this file to .env.local and fill in the values from your Supabase
# project dashboard. .env.local is gitignored.

# ----- Frontend (Vite reads these at build time) -----
# Settings → API → Project URL
VITE_SUPABASE_URL=
# Settings → API → Project API keys → "anon" "public"
VITE_SUPABASE_ANON_KEY=

# ----- Seed script (Node reads these at runtime) -----
# Same URL as above, just renamed for the Node script.
SUPABASE_URL=
# Settings → API → Project API keys → "service_role" (NEVER commit, NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
